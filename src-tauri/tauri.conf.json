{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaesarOS",
  "version": "0.1.0",
  "identifier": "os.caesaros.shell",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["caesaros"]
      }
    }
  }
}
